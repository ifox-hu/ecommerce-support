{
  "uid": "ecommerce-support",
  "title": "电商客服运行监控",
  "tags": ["ecommerce", "demo"],
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "客服请求量", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (outcome) (increase(ecommerce_operations_total{kind=\"agent\"}[1m]))", "legendFormat": "{{outcome}}"}]
    },
    {
      "id": 2, "title": "请求延迟 P50 / P95", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(ecommerce_operation_duration_seconds_bucket{kind=\"agent\"}[2m])))", "legendFormat": "P50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ecommerce_operation_duration_seconds_bucket{kind=\"agent\"}[2m])))", "legendFormat": "P95"}
      ]
    },
    {
      "id": 3, "title": "客服及工具成功率", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [{"refId": "A", "expr": "sum by (kind) (rate(ecommerce_operations_total{kind=~\"agent|tool\",outcome=~\"ok|success\"}[2m])) / sum by (kind) (rate(ecommerce_operations_total{kind=~\"agent|tool\"}[2m]))", "legendFormat": "{{kind}}"}]
    },
    {
      "id": 4, "title": "意图与最终路由", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (kind,name) (increase(ecommerce_operations_total{kind=~\"intent|route\"}[2m]))", "legendFormat": "{{kind}} {{name}}"}]
    },
    {
      "id": 5, "title": "补检索、转人工、降级和恢复", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (kind,name,outcome) (increase(ecommerce_operations_total{kind=~\"degraded|recovery\"}[2m]))", "legendFormat": "{{kind}} {{name}} {{outcome}}"},
        {"refId": "B", "expr": "sum by (name) (increase(ecommerce_operations_total{kind=\"route\",name=\"handoff\"}[2m]))", "legendFormat": "转人工"},
        {"refId": "C", "expr": "sum by (name) (increase(ecommerce_operations_total{kind=\"retrieval\",name=~\"supplement|retry|retry_retrieval\"}[2m]))", "legendFormat": "补检索 {{name}}"}
      ]
    },
    {
      "id": 6, "title": "Token 消耗", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (kind,name) (increase(ecommerce_tokens_total[2m]))", "legendFormat": "{{kind}} {{name}}"}]
    },
    {
      "id": 7, "title": "告警触发历史", "type": "timeseries",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "max by (alertname,alertstate) (ALERTS{alertname=~\"Ecommerce.*\"})", "legendFormat": "{{alertname}} {{alertstate}}"}]
    }
  ]
}
